  role: string;
  bio: string;
  followers: number;
  following: number;
  avatar: string;
  premium: boolean;
};

export type Post = {
  id: string;
  authorId: string;
  author: string;
  authorHandle: string;
  role: string;
  avatar: string;
  content: string;
  image?: string;
