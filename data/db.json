export async function ensureDatabase() {
  await fs.mkdir(path.dirname(dataFile), { recursive: true });

  try {
    await fs.access(dataFile);
  } catch {
    await fs.writeFile(dataFile, JSON.stringify(seedData, null, 2), "utf-8");
  }
}

export async function readDb(): Promise<Db> {
  await ensureDatabase();
  const raw = await fs.readFile(dataFile, "utf-8");
  return JSON.parse(raw) as Db;
}

export async function writeDb(db: Db) {
  await ensureDatabase();
  await fs.writeFile(dataFile, JSON.stringify(db, null, 2), "utf-8");
}

export async function getAuthenticatedUser() {
  const sessionCookie = cookies().get("galumbra_session")?.value;
  if (!sessionCookie) return null;

  const db = await readDb();
  return db.users.find((user) => user.id === sessionCookie) ?? null;
}

